{
  "name": "project-omen",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev:desktop": "concurrently -k \"npm:dev\" \"npm:dev:electron\"",
    "build": "tsc -b && vite build",
    "generate-icons": "node scripts/generate-icons.cjs",
    "pack": "npm run generate-icons && npm run build && electron-builder --dir",
    "dist": "npm run generate-icons && npm run build && electron-builder",
    "dist:unsigned": "node scripts/dist-win-unsigned.cjs",
    "dist:signed": "npm run dist:unsigned && node scripts/sign-win.cjs",
    "sign:win": "node scripts/sign-win.cjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "png-to-ico": "^2.0.0",
    "sharp": "^0.32.4",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-tsconfig-paths": "^1.4.1",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "build": {
    "appId": "com.omen.projectomen",
    "productName": "Project Omen",
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "build/**"
    ],
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "appx": {
      "applicationId": "ProjectOmen",
      "displayName": "Project Omen",
      "identityName": "YourPublisherName.ProjectOmen",
      "publisher": "CN=YourPublisherName",
      "publisherDisplayName": "Your Name"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Project Omen"
    }
  }
}
